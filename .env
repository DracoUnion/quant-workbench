# QuantWorkbench 环境变量配置
# 桌面端强制使用 SQLite + inline 执行器

# 数据库
DATABASE_URL=sqlite:///src/data/fin_workbench.db

# 运行执行器：inline 或 celery
RUN_EXECUTOR=inline

# LLM 配置（OpenAI 兼容）
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 搜索数据源
SEARCH_PROVIDER=mock

# 市场数据源
MARKET_DATA_PROVIDER=mock

# 推送通道
PUSH_CHANNEL=mock

# Celery/Redis（可选，非桌面部署）
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# 日志级别
LOG_LEVEL=INFO
